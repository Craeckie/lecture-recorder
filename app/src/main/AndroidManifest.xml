<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Load the wrapped site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The wrapped site records audio for transcription; MODIFY_AUDIO_SETTINGS is what
         lets the shell pick the USB mic as the communication device (see MicRouter). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Since API 28, a backgrounded app with no microphone-type foreground service is fed
         digital silence by the mic rather than an error. On 2026-09-01 that silently cost a
         real lecture 86.5 seconds (see docs/superpowers/specs/2026-09-01-device-log-findings.md,
         Part 1). CaptureForegroundService holds that exemption open while capture is live. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- API 33+. The service runs whether or not this is granted; without it the ongoing
         notification is simply not shown, which is the user's only sign the mic is held. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LectureRecorderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!-- configChanges is load-bearing for recording, not a performance tweak.
             Without it, rotating the phone destroys and recreates the activity, which
             rebuilds the WebView and reloads the page - and the site deletes the
             recording session on unload (POST /delete_session/<id>). One rotation
             mid-lecture would silently end the recording.

             uiMode is in the list for exactly the same reason, and it used to be
             absent: day/night was decided once per WebView instance, which only worked
             because a system theme change restarted the activity - and that restart
             ended a live recording just as surely as a rotation did. Day/night is now
             switched in place instead (see the isSystemInDarkTheme() effect in
             SiteWebView), so nothing here may reload the page. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets links to the wrapped site (e.g. the /webapi/shorten/<id> short links
                 handed out for QR codes) open directly in this app instead of a browser.
                 No autoVerify: that requires a Digital Asset Links file hosted on
                 lt2srv.iar.kit.edu, which this app doesn't control, so Android shows the
                 usual app chooser rather than claiming the link silently. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lt2srv.iar.kit.edu" />
            </intent-filter>
        </activity>

        <!-- exported=false: nothing outside this app has any business holding the
             microphone exemption open. foregroundServiceType is required from API 34 and
             ignored below it. -->
        <service
            android:name=".CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
