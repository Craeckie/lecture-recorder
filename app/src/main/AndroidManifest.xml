<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Load the wrapped site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The wrapped site records audio for transcription; MODIFY_AUDIO_SETTINGS is what
         lets the shell pick the USB mic as the communication device (see MicRouter). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".LectureRecorderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!-- configChanges is load-bearing for recording, not a performance tweak.
             Without it, rotating the phone destroys and recreates the activity, which
             rebuilds the WebView and reloads the page - and the site deletes the
             recording session on unload (POST /delete_session/<id>). One rotation
             mid-lecture would silently end the recording.

             uiMode is deliberately ABSENT: day/night is decided fresh per WebView
             instance from isNightMode(), which only works because a system theme change
             still restarts the activity. See CLAUDE.md pitfall #8. Do not add it here to
             "be consistent" with the rest of this list. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
